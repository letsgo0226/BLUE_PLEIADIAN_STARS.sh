[Unit]
Description=BLUE PLEIADIAN STARS all resident hologram loops
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/blue-pleiadian-stars
Environment=ROOT=/opt/blue-pleiadian-stars
Environment=DATA_ROOT=/var/lib/blue-pleiadian-stars
Environment=INTERVAL=1
ExecStart=/bin/sh /opt/blue-pleiadian-stars/deployment/all_residents/run_all.sh
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
